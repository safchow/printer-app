# Copy to .env and adjust. Everything has a safe default.

# The private address the web app listens on: a Tailscale IP, a WireGuard IP
# or a LAN IP. The default only listens on this machine.
BIND_ADDRESS=127.0.0.1
PORT=8090

# Where the database lives, and (later) where print files are stored.
DATA_DIR=./data
LIBRARY_ROOT=./library

# Which printers file to use (printers.fake.yaml for the fake printer).
PRINTERS_FILE=./printers.yaml

# Time zone for times shown in the app.
TZ=UTC

# Optional, used by later versions:
# IMPORT_TOKEN=          enables the import endpoint for Claude or scripts (empty = off)
# TAILSCALE_SOCKET=      shows device names in the action log
