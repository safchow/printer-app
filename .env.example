# Copy to .env and adjust. Everything has a safe default.

# The private address the web app listens on: a Tailscale IP, a WireGuard IP
# or a LAN IP. The default only listens on this machine.
BIND_ADDRESS=127.0.0.1
PORT=8090

# Where the database lives, and (later) where print files are stored.
DATA_DIR=./data
LIBRARY_ROOT=./library

# Which printers file to use (printers.fake.yaml for the fake printer).
PRINTERS_FILE=./printers.yaml

# Time zone for times shown in the app.
TZ=UTC

# Printer controls: pause, resume, stop, speed, fans, temperatures and the
# light. Off by default; every control answers "turned off" until you set this.
# CONTROLS_ENABLED=true
# Fetch the current print's G-code once per print for the 3D preview (false = off)
# GCODE_PREVIEW=true
# Keep a copy of each file sent to the printer, and the print history (false = off)
# CAPTURE_FILES=true

# Camera relay (docs/camera-relay.md). Leave unset to use the go2rtc container
# from compose.yaml. Set it empty (GO2RTC_URL=) to have browsers connect to the
# printer's camera directly instead, which needs a route to the printer.
# GO2RTC_URL=http://go2rtc:1984

# Optional, used by later versions:
# IMPORT_TOKEN=          enables the import endpoint for Claude or scripts (empty = off)
# TAILSCALE_SOCKET=      shows device names in the action log
